{
  "name": "openbabel",
  "version": "1.2.0",
  "description": "openbabel docker web service",
  "private": true,
  "type": "module",
  "homepage": "https://github.com/cheminfo/openbabel#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cheminfo/openbabel.git"
  },
  "bugs": {
    "url": "https://github.com/cheminfo/openbabel/issues"
  },
  "license": "MIT",
  "author": "Luc Patiny",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "build": "npm run build --workspace=frontend",
    "check-types": "npm run check-types --workspace=frontend",
    "dev": "node --watch --env-file-if-exists=.env src/index.js",
    "dev-frontend": "npm run dev --workspace=frontend",
    "eslint": "eslint .",
    "eslint-fix": "eslint . --fix",
    "prettier": "prettier --check .",
    "prettier-write": "prettier --write .",
    "start": "node --env-file-if-exists=.env src/index.js",
    "test": "npm run test-only && npm run check-types && npm run eslint && npm run prettier",
    "test-e2e": "npm run test-e2e --workspace=frontend",
    "test-only": "vitest run --coverage"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.0",
    "@fastify/sensible": "^6.0.4",
    "@fastify/static": "9.1.0",
    "@fastify/swagger": "^9.8.0",
    "@fastify/swagger-ui": "^5.2.5",
    "fastify": "^5.10.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.4",
    "eslint-config-zakodium": "^20.0.0",
    "prettier": "^3.9.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@fastify/static": "9.1.0"
  }
}
